# =============================================================================
# LOCAL DEVELOPMENT — Docker Postgres
# Keep DATABASE_URL identical in: .env, apps/web/.env, packages/db/.env
# Start DB: docker compose up -d db
# =============================================================================

DATABASE_URL="postgresql://primarywms:primarywms@127.0.0.1:55432/primarywms?schema=public"

# =============================================================================
# PRODUCTION (Vercel) — Prisma Postgres direct URL only
# Set in Vercel dashboard (NOT in committed .env files):
#   DATABASE_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
#   NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# =============================================================================

NEXT_PUBLIC_APP_NAME="Primary WMS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NEXT_PUBLIC_DEFAULT_ACCENT="#2E8B57"

# Email — optional locally (logged to console when SMTP_HOST is blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Primary WMS <noreply@localhost>"

# Supabase (images + PDFs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET="primarywms"
