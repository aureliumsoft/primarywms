# PostgreSQL
DATABASE_URL="postgresql://primarywms:primarywms@127.0.0.1:55432/primarywms?schema=public"

# Web
NEXT_PUBLIC_APP_NAME="Primary WMS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Default accent (sea green). Overridden by organization.accentColor after setup.
NEXT_PUBLIC_DEFAULT_ACCENT="#2E8B57"

# Email (leave blank in development — invites/resets are logged to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Primary WMS <noreply@localhost>"

# Object storage — Supabase (images + PDFs, shareable links)
# Create a project at https://supabase.com → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET="primarywms"

# Optional S3-compatible fallback (MinIO / R2). Leave blank when using Supabase.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=primarywms
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
